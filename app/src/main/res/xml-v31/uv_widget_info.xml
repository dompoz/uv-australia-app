<?xml version="1.0" encoding="utf-8"?>
<!--
    API 31+ override: omits minHeight/minWidth so the Sony Xperia launcher
    does not double-count them alongside targetCellWidth/Height, which causes
    a forced 1x2 initial placement on Sony devices.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="250dp"
    android:updatePeriodMillis="0"
    android:description="@string/widget_description"
    android:previewImage="@drawable/widget_preview"
    android:previewLayout="@layout/widget_preview"
    android:widgetCategory="home_screen"
    android:resizeMode="horizontal|vertical" />
